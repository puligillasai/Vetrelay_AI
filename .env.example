# VetRelay AI — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# ── IBM Cloud / watsonx ───────────────────────────────────────────────────────
IBM_CLOUD_API_KEY=your_ibm_cloud_api_key_here
WATSONX_ORCHESTRATE_URL=https://your-instance.orchestrate.cloud.ibm.com

# ── VetRelay Backend URL ──────────────────────────────────────────────────────
# Local dev:
VETRELAY_API_URL=http://localhost:8000
# After IBM Cloud Foundry deploy, replace with your real CF app URL:
# VETRELAY_API_URL=https://vetrelay-ai-backend.us-south.cf.appdomain.cloud
