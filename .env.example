WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=your_project_id_here
VETRELAY_API_URL=http://localhost:8000

# IBM Cloudant — appointment & triage record persistence
# All booking records (from /api/assess and /api/route-booking) are saved here.
CLOUDANT_APIKEY=your_cloudant_apikey_here
CLOUDANT_URL=https://<your-instance>.cloudantnosqldb.appdomain.cloud
CLOUDANT_DB_NAME=vetrelay_intakes

# IBM Watson Speech-to-Text — voice intake transcription
WATSON_STT_APIKEY=your_watson_stt_apikey_here
WATSON_STT_URL=https://api.us-south.speech-to-text.watson.cloud.ibm.com
